# Existing JSONBin Master Key. No original database Bin ID is needed.
JSONBIN_API_KEY=
# Template API Bearer key (at least 32 characters).
TEMPLATE_API_KEY=
# Optional separate editor key; absent uses TEMPLATE_API_KEY.
# EDITOR_API_KEY=
# Optional persistent metadata cache outside Vercel; default is a temp folder.
# BCSFE_DATA_DIR=
# Optional Fernet key; absent derives it from JSONBIN_API_KEY.
# TEMPLATE_ENCRYPTION_KEY=
